# Copie para .env.local e preencha. Nunca comite .env.local.
# A chave só é usada no server-side; nunca chega ao bundle do client.

ANTHROPIC_API_KEY=

# Opcional — modelo da Anthropic a usar. Padrão: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional — tetos de uso (defaults razoáveis se omitidos)
# RATE_LIMIT_PER_MINUTE=10
