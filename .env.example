# Copie para .env.local e preencha. Nunca comite .env.local.
#
# As features de IA são OPCIONAIS. O wizard manual funciona 100% sem elas.
# Para ligar (expandir ficha a partir de contexto, sugerir campo, regenerar
# seção, checar coerência):
#   1. Preencha ANTHROPIC_API_KEY (fica só no server-side).
#   2. Setar NEXT_PUBLIC_AI_ENABLED=true (mostra os botões na UI).
#
# Deixar as duas em branco mantém o app no modo manual, sem risco de custo.

ANTHROPIC_API_KEY=
NEXT_PUBLIC_AI_ENABLED=false

# Opcional — modelo da Anthropic a usar. Padrão: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional — tetos de uso (defaults razoáveis se omitidos)
# RATE_LIMIT_PER_MINUTE=10
