# Copie para .env.local e preencha. Nunca comite .env.local.

# ──────────────────────────────────────────────────────────────────────────
# Supabase — login + banco de personagens
# ──────────────────────────────────────────────────────────────────────────
# Sem essas duas vars, o app continua rodando no modo anônimo (localStorage
# apenas). Com elas, aparece o botão "Entrar" e cada conta tem seus próprios
# personagens.
#
# Como obter:
#   1. Crie um projeto grátis em https://supabase.com
#   2. Project Settings → API → copie "Project URL" e "anon public key"
#   3. Authentication → Providers → Google: ative e cole Client ID/Secret
#      (criados no Google Cloud Console → OAuth client Web)
#   4. Authentication → Providers → Email: deixe signups habilitados
#   5. SQL Editor: rode o conteúdo de supabase/migrations/0001_init.sql

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Anthropic — features de IA (opcionais)
# ──────────────────────────────────────────────────────────────────────────
# Para ligar (expandir ficha, sugerir campo, regenerar seção, checar
# coerência):
#   1. Preencha ANTHROPIC_API_KEY (fica só no server-side).
#   2. Setar NEXT_PUBLIC_AI_ENABLED=true (mostra os botões na UI).

ANTHROPIC_API_KEY=
NEXT_PUBLIC_AI_ENABLED=false

# Opcional — modelo da Anthropic a usar. Padrão: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional — tetos de uso (defaults razoáveis se omitidos)
# RATE_LIMIT_PER_MINUTE=10
